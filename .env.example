# Example .env for JobPilot (do NOT store real secrets here)

# ── Required API keys ─────────────────────────────────────────────────────────
# LLM provider key — see the "Multi-provider LLM" section below for how the
# generation/embedding/browser providers are selected. For hosted OpenAI set
# LLM_API_KEY (or OPENAI_API_KEY); for a local/self-hosted model set LLM_BASE_URL.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── Optional API keys ─────────────────────────────────────────────────────────
# SerpAPI key for the optional Google-jobs search fallback. Leave empty to
# disable; the app runs fine without it.
SERPAPI_KEY=

# ── Credential encryption (auto-generated on first launch if left empty) ──────
# WARNING — this key decrypts every SiteCredential, Gmail OAuth token, and
# OAuth state HMAC in jobpilot.db. Losing it means re-entering every site
# credential AND re-running the Gmail OAuth flow; there is NO recovery.
#
# Back the generated value up to a password manager BEFORE editing this file
# again. See docs/architecture.md → "Credentials & encryption" for the full
# rotation/restore procedure.
CREDENTIAL_KEY=

# ── App settings ──────────────────────────────────────────────────────────────
JOBPILOT_HOST=127.0.0.1
JOBPILOT_PORT=8000
JOBPILOT_LOG_LEVEL=info
JOBPILOT_DATA_DIR=./data
JOBPILOT_SCRAPER_HEADLESS=true
# Tier-2 apply uses a visible browser by default (watch/intervene on logins &
# captchas). Set true for headless/server/Docker runs with no display.
JOBPILOT_APPLY_HEADLESS=false
# Comma-separated list of allowed CORS origins. Set this if you serve the
# frontend on a host other than the local dev defaults (e.g. a reverse proxy
# in front of Docker). Leaving the default works for local-only use.
JOBPILOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Timeouts (seconds)
TECTONIC_TIMEOUT_SECONDS=60
# Per-request LLM timeout. Default (180) is sized for local *reasoning* models
# (Qwen/DeepSeek-R1), whose chain-of-thought can take 100s+ on a single
# CV-tailoring call. Drop to ~45 if you only use a fast hosted endpoint.
LLM_TIMEOUT_SECONDS=180

# ── Feature flags ─────────────────────────────────────────────────────────────
SCRAPLING_ENABLED=true
APPLY_TIER1_ENABLED=true

# ── Gmail integration ─────────────────────────────────────────────────────────
# Gmail integration — leave empty to disable. Obtain at console.cloud.google.com.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
GMAIL_BACKFILL_DAYS=30
GMAIL_POLL_INTERVAL_MINUTES=5

# ── Multi-provider LLM (applied on restart) ─────────────────────────────
# Generation: openai | anthropic
# "openai" means ANY OpenAI-compatible endpoint — hosted OpenAI, a local
# server (Ollama, LM Studio, vLLM, llama.cpp), or another vendor's
# OpenAI-compatible endpoint. Point LLM_BASE_URL at it and set LLM_MODEL to
# the served model id.
LLM_PROVIDER=openai
LLM_MODEL=
# Reasoning models (Qwen3, DeepSeek-R1) emit a long chain-of-thought that can
# make a single CV-tailoring call take 100s+. Set true to ask the server to
# skip "thinking" (chat_template_kwargs.enable_thinking=false) — typically a
# ~10x speedup. Ignored by models/servers that don't support the flag.
LLM_DISABLE_THINKING=false
#   LLM_BASE_URL=http://localhost:11434/v1     # Ollama
#   LLM_BASE_URL=http://192.168.1.50:8080/v1   # llama.cpp server on the LAN
#   LLM_MODEL=Qwen3.6-27B-MTP                   # must match the served model id
# Local endpoints usually need no key; any non-empty value works.
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: openai  (anthropic has no embeddings API)
# NOTE: many local builds (e.g. the llama.cpp Qwen build) do NOT serve
# /v1/embeddings (HTTP 501). Keep EMBEDDING_PROVIDER on an endpoint that
# serves an embedding model for fit-scoring.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Browser agent: openai  (anthropic only via an OpenAI-compatible base_url)
BROWSER_LLM_PROVIDER=openai
BROWSER_LLM_MODEL=
BROWSER_LLM_BASE_URL=
BROWSER_LLM_API_KEY=
